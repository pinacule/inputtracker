{
  "name": "inputtracker",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit && bun test",
    "dev": "bun run src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "it": "bun run src/cli/index.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "preact": "^11.0.1"
  }
}
