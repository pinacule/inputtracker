[Unit]
Description=InputTracker HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
# Config path: the app reads INPUTTRACKER_CONFIG from the environment when set,
# otherwise its own default. Nothing is hard-coded here.
PassEnvironment=INPUTTRACKER_CONFIG
ExecStart=@BUN@ run src/server/main.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
